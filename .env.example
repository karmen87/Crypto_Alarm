# Configuration reference. The app reads real environment variables (it does not load this
# file itself): export them, or use `docker compose` (env_file) / your process manager.

# --- Web server -----------------------------------------------------------------------
# Binds to localhost by default. There is no authentication: only use 0.0.0.0 on a trusted network.
CRYPTO_ALARM_HOST=127.0.0.1
CRYPTO_ALARM_PORT=5000
# Extra Socket.IO origins, comma-separated (same origin is always allowed)
# CRYPTO_ALARM_ALLOWED_ORIGINS=https://alarm.example.com
# Random on every start if unset
# CRYPTO_ALARM_SECRET_KEY=
# One JSON object per log line (handy in containers)
# CRYPTO_ALARM_LOG_JSON=1

# --- Storage ---------------------------------------------------------------------------
# Defaults to <project>/data/crypto_data_binance.json
# CRYPTO_ALARM_DATA=/data/crypto_data_binance.json

# --- Binance ---------------------------------------------------------------------------
# Market-data-only host, useful where api.binance.com is blocked
# BINANCE_API_BASE=https://data-api.binance.vision
# BINANCE_WS_BASE=wss://stream.binance.com:9443

# --- Notifications when no browser is open (all optional) ------------------------------
# NTFY_TOPIC=my-private-topic
# NTFY_SERVER=https://ntfy.sh
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALARM_WEBHOOK_URL=
